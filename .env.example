# Server-side secrets; obtain credentials from https://developer.riotgames.com/
RIOT_API_KEY=
# Requires separate tournament approval; stub endpoints use RIOT_API_KEY.
RIOT_TOURNAMENT_API_KEY=
# Optional player-specific OAuth bearer token, supplied by your RSO integration.
RIOT_RSO_ACCESS_TOKEN=
RIOT_PLATFORM=euw1
# Leave blank to derive: europe, americas, asia, sea (Oceania uses sea).
RIOT_REGIONAL=
RIOT_TIMEOUT=10
# Documentation routes are opt-in. Configure auth middleware when exposing them.
PILTOVER_DOCS_ENABLED=false
PILTOVER_DOCS_PATH=piltover/docs
PILTOVER_SPEC_PATH=piltover/docs/openapi.json
