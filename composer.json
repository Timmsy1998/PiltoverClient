{
  "name": "timmsy/piltover-client",
  "description": "League of Legends API client with tournament, RSO, rate limiting and optional Laravel integration.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "riot",
    "league of legends",
    "laravel",
    "api",
    "client",
    "composer",
    "php",
    "docs",
    "openapi",
    "redoc"
  ],
  "homepage": "https://github.com/Timmsy1998/PiltoverClient",
  "authors": [
    {
      "name": "James Timms",
      "email": "james@timmsy.dev"
    }
  ],
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^7.15.2",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5.50",
    "mockery/mockery": "^1.6",
    "illuminate/support": "^12.69 || ^13.30",
    "illuminate/config": "^12.69 || ^13.30",
    "illuminate/view": "^12.69 || ^13.30",
    "illuminate/routing": "^12.69 || ^13.30",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Timmsy\\PiltoverClient\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Timmsy\\PiltoverClient\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Timmsy\\PiltoverClient\\PiltoverClientServiceProvider"
      ],
      "aliases": {
        "Piltover": "Timmsy\\PiltoverClient\\Facades\\Piltover"
      }
    }
  },
  "scripts": {
    "docs:serve": "php -S 127.0.0.1:8765 -t resources",
    "test": "phpunit",
    "generate": "php tools/generate.php",
    "check:endpoints": "php tools/check-endpoints.php",
    "release": "php tools/release.php"
  },
  "config": {
    "sort-packages": true
  },
  "suggest": {
    "illuminate/support": "Required for Laravel integration (^12.69 || ^13.30).",
    "illuminate/config": "Required for Laravel integration (^12.69 || ^13.30).",
    "illuminate/view": "Required for Laravel integration (^12.69 || ^13.30).",
    "illuminate/routing": "Required for Laravel integration (^12.69 || ^13.30)."
  },
  "conflict": {
    "guzzlehttp/psr7": "<2.12.3"
  }
}
